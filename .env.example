# Database
# Railway: Add a PostgreSQL service, then use the DATABASE_URL from Railway variables
DATABASE_URL="postgresql://user:password@localhost:5432/honeybee_referral?schema=public"

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# App URL (required for Auth.js in production)
# Railway: Set to your Railway app domain (e.g., https://your-app.up.railway.app)
NEXTAUTH_URL="https://your-app.up.railway.app"

# Optional: OAuth providers (if you want to add social login later)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ============================================================================
# Railway Deployment Notes:
# ============================================================================
# 1. Create a new project on Railway
# 2. Add a PostgreSQL service from the Railway dashboard
# 3. Connect your GitHub repo to Railway
# 4. Set the following environment variables in Railway:
#    - DATABASE_URL (auto-populated if you use Railway's PostgreSQL)
#    - AUTH_SECRET (generate a secure random string)
#    - NEXTAUTH_URL (your Railway app URL)
# 5. Deploy will automatically run: npm install -> prisma generate -> next build
# ============================================================================
