// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  USER
  SUPERADMIN
}

enum CommissionType {
  PERCENT
  FLAT
}

enum LeadStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  AWAITING_ADMIN_CONFIRMATION
  COMPLETED_CONFIRMED
}

enum WalletTransactionType {
  CASH
  BENEFITS
  PLATFORM_PROFIT
}

// ============================================================================
// MODELS
// ============================================================================

model Company {
  id                   String    @id @default(cuid())
  name                 String
  memberId             String    @unique // Format: HB-000001
  canUseReferrerPortal Boolean   @default(false)
  canUseProviderPortal Boolean   @default(false)
  isSuspended          Boolean   @default(false)
  cashBalance          Decimal   @default(0) @db.Decimal(12, 2)
  benefitsBalance      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  users              User[]
  providerProfile    ProviderProfile?
  leadsAsProvider    Lead[]              @relation("ProviderLeads")
  leadsAsReferrer    Lead[]              @relation("ReferrerLeads")
  walletTransactions WalletTransaction[]

  @@index([memberId])
  @@index([isSuspended])
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

model ProviderProfile {
  id                String         @id @default(cuid())
  companyId         String         @unique
  zipCode           String
  serviceCategories String[]
  shortDescription  String         @db.Text
  commissionType    CommissionType
  commissionValue   Decimal        @db.Decimal(10, 2)
  isPublished       Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([zipCode])
  @@index([isPublished])
}

model Lead {
  id                      String         @id @default(cuid())
  providerCompanyId       String
  referrerCompanyId       String
  homeownerName           String
  homeownerPhone          String
  homeownerAddress        String         @db.Text
  projectDescription      String         @db.Text
  category                String
  status                  LeadStatus     @default(SUBMITTED)
  reportedJobValue        Decimal?       @db.Decimal(12, 2)
  commissionTypeSnapshot  CommissionType
  commissionValueSnapshot Decimal        @db.Decimal(10, 2)
  calculatedCommission    Decimal?       @db.Decimal(12, 2)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  // Relations
  providerCompany    Company             @relation("ProviderLeads", fields: [providerCompanyId], references: [id], onDelete: Cascade)
  referrerCompany    Company             @relation("ReferrerLeads", fields: [referrerCompanyId], references: [id], onDelete: Cascade)
  walletTransactions WalletTransaction[]

  @@index([providerCompanyId])
  @@index([referrerCompanyId])
  @@index([status])
  @@index([createdAt])
}

model WalletTransaction {
  id        String                @id @default(cuid())
  companyId String? // Nullable for platform profit entries
  leadId    String
  type      WalletTransactionType
  amount    Decimal               @db.Decimal(12, 2)
  createdAt DateTime              @default(now())

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}
